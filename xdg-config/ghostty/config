font-family = "FiraCode Nerd Font Mono"
font-family-bold = "FiraCode Nerd Font Mono Bold"
font-family-italic = "JetBrainsMono NFM Italic" 
font-family-bold-italic = "JetBrainsMono NFM Bold Italic"
font-size = 12 
font-feature = "liga"
theme = OneDark
window-decoration = none
window-padding-x = 1
window-padding-y = 5
confirm-close-surface = false

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

