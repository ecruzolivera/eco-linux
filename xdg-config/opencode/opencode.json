{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "opencode-go/deepseek-v4-flash",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "color": "accent"
    },
    "build": {
      "color": "#ff6b6b"
    }
  },
  "permission": {
    "bash": {
      "sudo *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "env:$TMPDIR": "allow",
      "env:$TMPDIR/*": "allow"
    },
    "websearch": "allow"
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ]
}
