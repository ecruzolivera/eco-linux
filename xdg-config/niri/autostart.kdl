// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup


// DMS supplies the authentication agent; do not launch a duplicate.
spawn-at-startup  "brave"
spawn-sh-at-startup  "$TERMINAL"
spawn-sh-at-startup "sleep 5 && command -v megasync >/dev/null && megasync"
spawn-sh-at-startup "sleep 6 && bitwarden-desktop"
spawn-sh-at-startup "sleep 8 && command -v slack >/dev/null && slack"
