#!/usr/bin/env bash

PROJECTS_DIR=~/Work

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find ~/.config $PROJECTS_DIR $PROJECTS_DIR/Forme $PROJECTS_DIR/Forme/wattbike-hub $PROJECTS_DIR/Personal $PROJECTS_DIR/Scratchpad ~/TTRPG ~/ -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
  exit 1
fi

# Create unique session name with parent directory
parent_dir=$(basename "$(dirname "$selected")")
base_dir=$(basename "$selected")
selected_name=$(echo "${parent_dir}-${base_dir}" | tr . _)

# Create session with 3 windows if it doesn't exist
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected" -n "Editor"
  tmux new-window -t "$selected_name:" -n "AI" -c "$selected"
  tmux new-window -t "$selected_name:" -n "Server" -c "$selected"
  tmux new-window -t "$selected_name:" -n "CLI" -c "$selected"
  # Start nvim in Editor window
  tmux send-keys -t "$selected_name:Editor" "nvim" Enter
  tmux send-keys -t "$selected_name:AI" "ocp" Enter
  tmux select-window -t "$selected_name:1"
fi

# Attach or switch based on current context
if [[ -z $TMUX ]]; then
  # Not in tmux: attach to the session
  tmux attach-session -t "$selected_name"
else
  # Already in tmux: switch to the session
  tmux switch-client -t "$selected_name"
fi
