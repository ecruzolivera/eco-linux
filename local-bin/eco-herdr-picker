#!/usr/bin/env bash

input=$(herdr workspace list 2>/dev/null \
  | jq -r '.result.workspaces[] | "\(.label)\t\(.workspace_id)"')

[[ -z $input ]] && exit 0

out=$(printf '%s\n' "$input" | fzf \
  --disabled \
  --bind 'j:down,k:up' \
  --expect=x \
  --delimiter=$'\t' --with-nth=1 \
  --prompt 'Workspace (j/k, enter=switch, x=kill) ')

[[ -z $out ]] && exit 0

key=$(printf '%s\n' "$out" | sed -n '1p')
sel=$(printf '%s\n' "$out" | sed -n '2p')
id=$(printf '%s\n' "$sel" | cut -f2)
[[ -z $id ]] && exit 0

if [[ $key == "x" ]]; then
  herdr workspace close "$id"
else
  herdr workspace focus "$id"
fi
