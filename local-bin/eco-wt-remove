#!/usr/bin/env bash

# Remove a Git worktree from herdr (or a shell) via worktrunk.
# Bound to prefix+shift+d in herdr as a popup: fzf lists the repo's removable
# worktrees, pick one, and wt remove deletes the checkout (killing dev-server
# / agent processes with --reap), deletes the branch if merged, and fires the
# pre-remove hook which closes the standalone herdr workspace.

# Resolve the target repo directory. In a herdr popup the active pane id is
# provided via HERDR_ACTIVE_PANE_ID; its cwd is the repo the user is in.
resolve_repo() {
  local pane_cwd
  if [[ -n ${HERDR_ACTIVE_PANE_ID:-} ]]; then
    pane_cwd=$(herdr pane get --pane "$HERDR_ACTIVE_PANE_ID" 2>/dev/null \
      | jq -r '.result.pane.cwd // empty' 2>/dev/null)
    [[ -n $pane_cwd ]] && printf '%s\n' "$pane_cwd" && return 0
  fi
  printf '%s\n' "$PWD"
}

dir=$(resolve_repo)

top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || {
  printf 'Not inside a git repository (cwd: %s)\n' "$dir"
  read -n 1 -r -s -p 'Press any key to close...'
  exit 1
}
cd "$top" || exit 1

# Branches with a worktree that is not the main checkout.
mapfile -t branches < <(wt list --format=json 2>/dev/null \
  | jq -r '.items[] | select(.worktree.main == false and .worktree.path) | .branch')

if [[ ${#branches[@]} -eq 0 ]]; then
  printf 'No removable worktrees here.\n'
  read -n 1 -r -s -p 'Press any key to close...'
  exit 0
fi

branch=$(printf '%s\n' "${branches[@]}" | fzf --prompt='remove worktree: ' --border \
  --header='j/k or arrows to select, enter to remove, esc to cancel')

[[ -z $branch ]] && exit 0

wt remove --reap --foreground "$branch"
